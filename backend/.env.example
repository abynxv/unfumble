# ─── Backend Environment Variables ───
# Copy this file to .env and fill in the values.
# Find all values in: Supabase Dashboard → Project Settings → Data API

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-eyJhbGci...
SUPABASE_JWT_SECRET=your-jwt-secret-from-settings-data-api-jwt-settings
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-eyJhbGci...
SUPABASE_STORAGE_BUCKET=generations

# Database (Supabase PostgreSQL — use asyncpg driver + port 6543 for pooler)
DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# Hugging Face (https://huggingface.co → Settings → Access Tokens)
HUGGINGFACE_API_KEY=hf_your_api_key_here
HUGGINGFACE_MODEL_ID=timbrooks/instruct-pix2pix

# Admin — comma-separated emails that get admin dashboard access
ADMIN_EMAILS=you@example.com

# App
APP_ENV=development
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=10
